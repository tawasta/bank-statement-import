<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="account_statement_import_form" model="ir.ui.view">
    <field name="model">account.statement.import</field>
    <field
      name="inherit_id"
      ref="account_statement_import_file.account_statement_import_form"
    />
    <field name="arch" type="xml">
      <field name="statement_file" position="before">
        <group>
          <field name="is_csv" widget="boolean_toggle" />
        </group>
        <p invisible="not is_csv">
                    Please ensure your CSV file has headers (in this order): <strong
        >Payer, Amount, Date, and Reference.</strong>
                </p>
      </field>
    </field>
  </record>
</odoo>

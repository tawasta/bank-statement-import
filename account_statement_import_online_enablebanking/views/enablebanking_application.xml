<?xml version="1.0" ?>
<odoo>
  <record id="enablebanking_application_form_view" model="ir.ui.view">
    <field name="name">enablebanking_application_form_view</field>
    <field name="model">enablebanking.application</field>
    <field name="arch" type="xml">
      <form string="EnableBanking application">
        <header>
          <button
            string="Bank authentication"
            invisible="aspsp_name == False"
            type="object"
            name="action_enablebanking_authenticate"
            groups="base.group_system"
            class="oe_highlight"
          />
          <button
            string="Deauthorize"
            invisible="not session or session == '{}'"
            type="object"
            name="action_enablebanking_deauthorize"
            groups="base.group_system"
            class="oe_highlight"
            confirm="Are you sure you want to deauthorize this application? This will require re-authentication."
          />
        </header>
        <sheet string="Form">
          <group name="enablebanking" string="EnableBanking application">
            <group name="credentials" string="Credentials">
              <field name="session" invisible="1" />
              <field name="valid_until" invisible="not session" />
              <field name="authenticated_bank_accounts" invisible="not session" />
              <field name="application_id" />
              <field name="bank_id" />
              <field name="user_id" />
              <field name="psu_type" />
              <field name="redirect_url" />
              <field name="company_id" />
              <field name="key_name" invisible="1" />
              <field name="key" filename="key_name" />
              <field
                name="online_bank_statement_provider_ids"
                readonly="1"
                widget="many2many_tags"
              />
            </group>

            <group name="aspsp" string="ASPSP">
              <label for="aspsp_name" string="ASPSP info" />
              <div class="o_row">
                <button
                  string="Get ASPSP info"
                  type="object"
                  invisible="bank_id == False"
                  name="action_enablebanking_get_aspsp"
                  groups="base.group_system"
                  class="oe_highlight"
                />
              </div>

              <field name="aspsp_name" />
              <field name="aspsp_country" />
              <field
                name="enablebanking_state"
                groups="base.group_no_one"
                readonly="1"
              />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="enablebanking_application_action" model="ir.actions.act_window">
    <field name="name">EnableBanking Applications</field>
    <field name="res_model">enablebanking.application</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="enablebanking_application_menu"
    action="enablebanking_application_action"
    parent="account.account_account_menu"
    sequence="120"
  />
</odoo>
